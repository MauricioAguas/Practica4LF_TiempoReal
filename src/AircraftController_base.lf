target C {
    timeout: 20 sec
}

// ============================================================
// Referencia: 100 m/s inicialmente y 110 m/s desde t = 10 s.
// Publicación cada 100 ms.
// ============================================================
reactor SpeedReference {
    output referencia: double

    state publicaciones: int = 0

    timer reference_timer(0, 100 ms)

    reaction(reference_timer) -> referencia {=
        double ref;

        if (self->publicaciones < 100) {
            ref = 100.0;
        } else {
            ref = 110.0;
        }

        lf_set(referencia, ref);
        self->publicaciones++;
    =}
}

// ============================================================
// Planta longitudinal.
// IMPORTANTE: publica/actualiza antes de recibir el nuevo empuje.
// ============================================================
reactor AircraftDynamics {
    input empuje: double
    output velocidad: double

    state v: double = 80.0
    state ultimo_empuje: double = 0.0

    state ts: double = 0.01
    state a_t: double = 20.0
    state a_d: double = 0.1

    timer dynamics_timer(10 ms, 10 ms)

    // Estado inicial v[0], sin integrar.
    reaction(startup) -> velocidad {=
        lf_set(velocidad, self->v);
    =}

    // Usa el comando almacenado en la actualización anterior.
    reaction(dynamics_timer) -> velocidad {=
        double aceleracion =
            self->a_t * self->ultimo_empuje
            - self->a_d * self->v;

        self->v += self->ts * aceleracion;

        lf_set(velocidad, self->v);
    =}

    // Debe permanecer después de las reacciones anteriores.
    reaction(empuje) {=
        self->ultimo_empuje = empuje->value;
    =}
}

// ============================================================
// Sensor: publica cada 5 ms.
// Esta versión inicial no inyecta perturbación.
// ============================================================
reactor AirDataSensor {
    input velocidad: double
    output medicion: double

    state ultima_velocidad: double = 80.0
    state perturbacion: double = 0.0

    timer sensor_timer(0, 5 ms)

    reaction(velocidad) {=
        self->ultima_velocidad = velocidad->value;
    =}

    reaction(sensor_timer) -> medicion {=
        double v_med =
            self->ultima_velocidad + self->perturbacion;

        lf_set(medicion, v_med);
    =}
}

// ============================================================
// Controlador proporcional: cálculo cada 10 ms.
// Las entradas se almacenan antes del cálculo periódico.
// ============================================================
reactor SpeedController(kp: double = 0.2) {
    input referencia: double
    input medicion: double

    output error: double
    output empuje: double

    state ultima_referencia: double = 0.0
    state ultima_medicion: double = 0.0

    state referencia_recibida: int = 0
    state medicion_recibida: int = 0

    timer controller_timer(0, 10 ms)

    reaction(referencia) {=
        self->ultima_referencia = referencia->value;
        self->referencia_recibida = 1;
    =}

    reaction(medicion) {=
        self->ultima_medicion = medicion->value;
        self->medicion_recibida = 1;
    =}

    reaction(controller_timer) -> error, empuje {=
        if (self->referencia_recibida &&
            self->medicion_recibida) {

            double e =
                self->ultima_referencia
                - self->ultima_medicion;

            double u = self->kp * e;

            if (u < 0.0) {
                u = 0.0;
            } else if (u > 1.0) {
                u = 1.0;
            }

            lf_set(error, e);
            lf_set(empuje, u);
        }
    =}
}

// ============================================================
// Monitor: almacena eventos y muestra una fila cada 100 ms.
// El tiempo mostrado se deriva de su contador periódico.
// No es una medición del reloj físico.
// ============================================================
reactor FlightMonitor {
    input referencia: double
    input velocidad: double
    input medicion: double
    input error: double
    input empuje: double

    state ref_guardada: double = 0.0
    state v_guardada: double = 0.0
    state med_guardada: double = 0.0
    state error_guardado: double = 0.0
    state empuje_guardado: double = 0.0

    state fila: int = 0

    timer monitor_timer(0, 100 ms)

    reaction(referencia, velocidad, medicion, error, empuje) {=
        if (referencia->is_present) {
            self->ref_guardada = referencia->value;
        }

        if (velocidad->is_present) {
            self->v_guardada = velocidad->value;
        }

        if (medicion->is_present) {
            self->med_guardada = medicion->value;
        }

        if (error->is_present) {
            self->error_guardado = error->value;
        }

        if (empuje->is_present) {
            self->empuje_guardado = empuje->value;
        }
    =}

    reaction(monitor_timer) {=
        double t_modelo = self->fila * 0.1;

        if (self->fila == 0) {
            printf(
                "t_modelo_s,referencia_m_s,velocidad_m_s,"
                "medicion_m_s,error_m_s,empuje\n"
            );
        }

        printf(
            "%.3f,%.6f,%.6f,%.6f,%.6f,%.6f\n",
            t_modelo,
            self->ref_guardada,
            self->v_guardada,
            self->med_guardada,
            self->error_guardado,
            self->empuje_guardado
        );

        self->fila++;
    =}
}

// ============================================================
// Composición del sistema.
// ============================================================
main reactor AircraftController {
    referencia = new SpeedReference()
    planta = new AircraftDynamics()
    sensor = new AirDataSensor()
    controlador = new SpeedController(kp = 0.2)
    monitor = new FlightMonitor()

    referencia.referencia -> controlador.referencia

    planta.velocidad -> sensor.velocidad
    sensor.medicion -> controlador.medicion
    controlador.empuje -> planta.empuje

    referencia.referencia -> monitor.referencia
    planta.velocidad -> monitor.velocidad
    sensor.medicion -> monitor.medicion
    controlador.error -> monitor.error
    controlador.empuje -> monitor.empuje
}
